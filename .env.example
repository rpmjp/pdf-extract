# Documentation reference only. Do not commit a real .env file.
APP_ENV=development
API_PORT=8003

POSTGRES_USER=pdfextract
POSTGRES_PASSWORD=<set-in-local-env>
POSTGRES_DB=pdfextract_dev
POSTGRES_PORT=5434

REDIS_PORT=6380

MINIO_ROOT_USER=<set-in-local-env>
MINIO_ROOT_PASSWORD=<set-in-local-env>
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

MINIO_ACCESS_KEY=<same-as-minio-root-user-for-local-dev>
MINIO_SECRET_KEY=<same-as-minio-root-password-for-local-dev>

JWT_SECRET=<32-plus-character-random-secret>
JWT_KEY_ID=dev-v1
JWT_PREVIOUS_SECRETS=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SEED_DEV_USERS=true
ALLOW_QUERY_TOKEN_AUTH=true

LLM_BACKEND=ollama
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=qwen2.5vl:7b

# ── Object storage ────────────────────────────────────────────────────────────
# Primary bucket name (also determines replica bucket: <name>-backup)
MINIO_BUCKET=documents
# MinIO KMS secret for server-side encryption (format: key-name:base64-secret)
MINIO_KMS_SECRET_KEY=<name>:<32-byte-base64-secret>

# ── Backup (pgBackRest) ───────────────────────────────────────────────────────
# For production S3 backup, add these to docker-compose.production.yml or
# ops/postgres/pgbackrest.conf instead of here.
# PGBACKREST_REPO1_TYPE=s3
# PGBACKREST_REPO1_S3_BUCKET=your-pgbackrest-bucket
# PGBACKREST_REPO1_S3_ENDPOINT=s3.amazonaws.com
# PGBACKREST_REPO1_S3_REGION=us-east-1
# PGBACKREST_REPO1_S3_KEY=<AWS_ACCESS_KEY_ID>
# PGBACKREST_REPO1_S3_KEY_SECRET=<AWS_SECRET_ACCESS_KEY>
